# Yoink configuration.  cp .env.example .env  and edit.
# Every setting is optional — the values shown are the defaults you get
# if you leave the line commented out.

# ----------------------------------------------------------------- storage

# Host folder where finished audio lands. Must be writable by uid 10001,
# the unprivileged user the container runs as:
#   mkdir -p /srv/music/yoink && chown 10001:10001 /srv/music/yoink
YOINK_DOWNLOADS=./downloads

# Days a finished download is kept before it is deleted automatically.
#YOINK_KEEP_DAYS=7

# ------------------------------------------------------------------ access

# Password for the web UI. Unset means no login at all, which is correct
# when the port is loopback-only and something in front (Cloudflare Access,
# Tailscale, your own proxy) does the authenticating.
# Read "Putting it on the internet" in the README before you rely on this.
#YOINK_PASSWORD=

# Cookie-signing secret. Generated once into the data volume when unset.
# Set it explicitly to keep people logged in across a volume reset.
#YOINK_SECRET=

# ------------------------------------------------------------------ tuning

# Parallel downloads inside one job. Two jobs can run at once (see "How it
# works" in the README), so peak load is roughly double this. Lower it to 2
# on a small NAS or SBC CPU.
#YOINK_THREADS=4

# Seconds a link lookup may take before Yoink gives up and says so. Keep it
# below your reverse proxy's origin timeout — Cloudflare's is 100 s.
#YOINK_PREFLIGHT_TIMEOUT=80

# Check PyPI every 6 hours for a newer yt-dlp and show a rebuild banner
# when one exists. Set to 0 to disable the check.
#YOINK_UPDATE_CHECK=1
